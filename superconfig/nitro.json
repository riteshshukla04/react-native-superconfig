{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "superconfig"
  ],
  "ios": {
    "iosModuleName": "NitroSuperconfig"
  },
  "android": {
    "androidNamespace": [
      "superconfig"
    ],
    "androidCxxLibName": "NitroSuperconfig"
  },
  "autolinking": {
    "Config": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridConfig"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
