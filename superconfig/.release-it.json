{
    "git": {
        "commitMessage": "chore: release v${version}",
        "tagName": "v${version}",
        "requireCleanWorkingDir": false,
        "requireUpstream": false
    },
    "npm": {
        "publish": true
    },
    "github": {
        "release": true
    },
    "hooks": {
        "before:init": [
            "npm run typescript"
        ]
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": "angular",
            "infile": "CHANGELOG.md"
        }
    }
}